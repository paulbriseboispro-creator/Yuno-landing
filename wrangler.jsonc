{
  // Cloudflare Workers config for the Yuno landing page (TanStack Start SSR).
  // `bun run build` outputs:
  //   - dist/server/server.js  -> the Worker (default export with a fetch handler)
  //   - dist/client/           -> static assets (JS/CSS/images) served by Cloudflare
  // Cloudflare serves a matching static asset first, and falls through to the
  // Worker for everything else (SSR routes + server functions).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yuno-landing",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  // nodejs_compat gives the Supabase client Node built-ins and, with this
  // compatibility_date, auto-populates process.env from the Worker's vars/secrets.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true
  },
  // Public runtime config — safe to commit. The landing has no Supabase project of its own:
  // everything (signup funnel, contact form) goes to the Yuno app's project (src/lib/yuno-app.ts).
  "vars": {
    // Public PostHog project key (phc_…), mirrored from the dashboard so a
    // deploy doesn't wipe it. NOTE: src/lib/posthog.ts reads it through
    // import.meta.env at BUILD time — for tracking to actually load it must
    // also be set as a Cloudflare *Build* variable.
    "VITE_POSTHOG_KEY": "phc_xsbSXWwUKTxjYaceQyofygm5e5cXrcWWMZZQaPhbcYY8"
  }
}
