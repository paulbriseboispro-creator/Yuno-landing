# The landing has no Supabase project of its own: the signup funnel and the contact
# form use the Yuno app's project through the public key in src/lib/yuno-app.ts.
# Override only for a staging project:
# VITE_YUNO_SUPABASE_URL="https://xxxx.supabase.co"
# VITE_YUNO_SUPABASE_KEY="sb_publishable_xxx"

# PostHog (public `phc_…` project key, inlined at build time). Leave empty
# locally to keep dev traffic out of the production funnel.
# VITE_POSTHOG_KEY="phc_xxx"
